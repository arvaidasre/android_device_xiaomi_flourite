// Google Camera (GCam port, BSG MGC 9.7.047 V33 "snap").
// APK is not committed (457 MB, over GitHub's 100 MB per-file limit); fetch it
// with ./fetch-gcam.sh before building. The module is presigned by the port's
// author, so it must not be re-signed by the platform keys.
android_app_import {
    name: "GoogleCamera",
    apk: "GoogleCamera.apk",
    presigned: true,
    // targetSdk >= 30 + presigned: keep the APK byte-identical so its v2
    // signature survives.
    preprocessed: true,
    // The port ships compressed JNI libs with extractNativeLibs="true" in its
    // manifest, so they are extracted at install time; the preprocessed check
    // exists for the uncompressed (mmap'd) GMS layout and does not apply.
    skip_preprocessed_apk_checks: true,
    dex_preopt: {
        enabled: false,
    },
    // Stock ships the camera as a vendor app (org.codeaurora.snapcam already
    // has a vendor seapp_context, and the Treble labelling test rejects that
    // package name on a platform partition).
    vendor: true,
}
