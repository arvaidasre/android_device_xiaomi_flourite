// Keep the stock audio layout available under both VINTF variant SKUs.
install_symlink {
    name: "flourite_audio_odm_cn_symlink",
    device_specific: true,
    installed_location: "etc/audio/sku_flourite_cn",
    symlink_target: "sku_volcano",
}

install_symlink {
    name: "flourite_audio_odm_global_symlink",
    device_specific: true,
    installed_location: "etc/audio/sku_flourite_global",
    symlink_target: "sku_volcano",
}

install_symlink {
    name: "flourite_audio_odm_cn_qssi_symlink",
    device_specific: true,
    installed_location: "etc/audio/sku_flourite_cn_qssi",
    symlink_target: "sku_volcano_qssi",
}

install_symlink {
    name: "flourite_audio_odm_global_qssi_symlink",
    device_specific: true,
    installed_location: "etc/audio/sku_flourite_global_qssi",
    symlink_target: "sku_volcano_qssi",
}

install_symlink {
    name: "flourite_audio_vendor_cn_symlink",
    vendor: true,
    installed_location: "etc/audio/sku_flourite_cn",
    symlink_target: "sku_volcano",
}

install_symlink {
    name: "flourite_audio_vendor_global_symlink",
    vendor: true,
    installed_location: "etc/audio/sku_flourite_global",
    symlink_target: "sku_volcano",
}

install_symlink {
    name: "flourite_audio_vendor_cn_qssi_symlink",
    vendor: true,
    installed_location: "etc/audio/sku_flourite_cn_qssi",
    symlink_target: "sku_volcano_qssi",
}

install_symlink {
    name: "flourite_audio_vendor_global_qssi_symlink",
    vendor: true,
    installed_location: "etc/audio/sku_flourite_global_qssi",
    symlink_target: "sku_volcano_qssi",
}

// PAL resolves /vendor/etc/audio/sku_<sku>/mixer_paths_<target>[_<variant>].xml
// from the sound card name and only falls back to the variant-less form. Stock
// ships just the _mtp variants, so a card name without a variant token (e.g.
// "volcano-snd-card") would leave the HAL with no route table at all - silence.
// Provide the variant-less names as symlinks so both shapes resolve.
install_symlink {
    name: "flourite_audio_mixer_paths_fallback",
    vendor: true,
    installed_location: "etc/audio/sku_volcano/mixer_paths_volcano.xml",
    symlink_target: "mixer_paths_volcano_mtp.xml",
}

install_symlink {
    name: "flourite_audio_resourcemanager_fallback",
    vendor: true,
    installed_location: "etc/audio/sku_volcano/resourcemanager_volcano.xml",
    symlink_target: "resourcemanager_volcano_mtp.xml",
}
