<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.flourite"
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.KILL_ALL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:name=".PartsApplication"
        android:label="@string/flourite_parts_title"
        android:icon="@drawable/ic_xiaomi_parts"
        android:theme="@style/FlouriteParts.Theme">
        <activity android:name=".PartsActivity" android:exported="true"
            android:permission="android.permission.DEVICE_POWER" android:label="@string/flourite_parts_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category" android:value="com.android.settings.category.ia.system" />
            <meta-data android:name="com.android.settings.group_key" android:value="system_management_category" />
            <meta-data android:name="com.android.settings.order" android:value="110" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/flourite_parts_title" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/flourite_parts_summary" />
            <meta-data android:name="com.android.settings.icon" android:resource="@drawable/ic_xiaomi_parts" />
            <meta-data android:name="com.android.settings.icon_tintable" android:value="true" />
            <meta-data android:name="com.android.settings.keyhint" android:value="flourite_parts_settings" />
            <meta-data android:name="com.android.settings.profile" android:value="primary_profile_only" />
        </activity>
        <activity android:name=".PartsSubActivity" android:exported="false" android:label="@string/flourite_parts_title" />
    </application>
</manifest>
